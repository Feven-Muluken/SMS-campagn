# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (MySQL default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sms_campaign
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
# Optional: fail fast if MySQL is unreachable (ms). Pool acquire timeout also caps how long a request waits for a DB connection.
# DB_CONNECT_TIMEOUT_MS=15000
# DB_POOL_MAX=10
# DB_POOL_ACQUIRE_MS=60000
# Set true to let Sequelize alter tables (use carefully in production). New columns are also added on startup via ensureDbColumns().
DB_SYNC_ALTER=false

# JWT
JWT_SECRET=change-me

# SMS outbound provider (default fallback): africastalking | mobilesms_io
SMS_PROVIDER=africastalking
# Allow users to select provider per send (true) or force SMS_PROVIDER only (false)
SMS_PROVIDER_USER_SELECTABLE=true

# SMS cost per SMS part (for UI estimation only; actual costs from provider account)
AT_COST_PER_SMS=0.05
MOBILESMS_IO_COST_PER_SMS=0.07

# Africa's Talking
AT_USERNAME=your_sandbox_or_live_username
AT_API_KEY=your_api_key
AT_SENDER_ID=

# MobileSMS.io / HTTP JSON SMS (when SMS_PROVIDER=mobilesms_io)
# Set base URL and path from your MobileSMS.io business SMS (or reseller) API documentation.
MOBILESMS_IO_BASE_URL=
MOBILESMS_IO_SEND_PATH=/sms/send
MOBILESMS_IO_API_KEY=
# bearer | api_key_header | query | none
MOBILESMS_IO_AUTH_STYLE=bearer
# json | form
MOBILESMS_IO_REQUEST_FORMAT=json
# Used when MOBILESMS_IO_AUTH_STYLE=api_key_header
MOBILESMS_IO_API_KEY_HEADER=X-API-Key
# Query param name when MOBILESMS_IO_AUTH_STYLE=query
MOBILESMS_IO_QUERY_PARAM=api_key
# JSON body field names (adjust to match vendor)
MOBILESMS_IO_FIELD_TO=to
MOBILESMS_IO_FIELD_MESSAGE=message
MOBILESMS_IO_FIELD_FROM=from
MOBILESMS_IO_DEFAULT_SENDER=
# Strip leading + from E.164 before sending (some gateways want national digits only)
MOBILESMS_IO_STRIP_PLUS=false
# Dot-path for message id in JSON response (used for delivery correlation if vendor supports it)
MOBILESMS_IO_MESSAGE_ID_JSON_PATH=message_id
# Optional: require a JSON flag to be true (dot path, e.g. success)
MOBILESMS_IO_SUCCESS_FLAG_PATH=
MOBILESMS_IO_SUCCESS_FLAG_EXPECTED=true
# Optional extra JSON merged into every send body (object JSON)
MOBILESMS_IO_EXTRA_JSON=
MOBILESMS_IO_TIMEOUT_MS=30000

# Webhook secrets (optional; used to verify provider callbacks)
# SMS_WEBHOOK_SECRET is the universal secret; provider-specific secrets also supported
SMS_WEBHOOK_SECRET=
AT_WEBHOOK_SECRET=
MOBILESMS_IO_WEBHOOK_SECRET=

# Phone parsing (libphonenumber-js): use ISO region and/or calling code for national numbers
# DEFAULT_PHONE_REGION=ET
DEFAULT_PHONE_COUNTRY_CODE=251

# Webhooks (configure in your SMS provider dashboard)
# Inbound SMS → POST https://your-api.example.com/sms/inbound (alias: /sms/webhooks/inbound)
# Delivery reports → POST https://your-api.example.com/sms/delivery-report (alias: /sms/webhooks/delivery-report)
# Optional shared secret (header x-at-webhook-secret, x-webhook-secret, x-sms-webhook-secret, or ?secret=)
SMS_WEBHOOK_SECRET=
# Backward-compatible provider-specific secrets
AT_WEBHOOK_SECRET=
MOBILESMS_IO_WEBHOOK_SECRET=

# MobileSMS.io webhook payload overrides (leave blank unless your vendor uses different field names)
MOBILESMS_IO_WEBHOOK_FROM_PATH=
MOBILESMS_IO_WEBHOOK_TEXT_PATH=
MOBILESMS_IO_WEBHOOK_MESSAGE_ID_PATH=
MOBILESMS_IO_WEBHOOK_DATE_PATH=
MOBILESMS_IO_WEBHOOK_STATUS_PATH=
MOBILESMS_IO_WEBHOOK_PHONE_PATH=
MOBILESMS_IO_WEBHOOK_NETWORK_CODE_PATH=
MOBILESMS_IO_WEBHOOK_FAILURE_REASON_PATH=
MOBILESMS_IO_WEBHOOK_RETRY_COUNT_PATH=

# Campaign scheduler
CAMPAIGN_SCHEDULER_ENABLED=true
CAMPAIGN_SCHEDULER_INTERVAL_MS=60000
CAMPAIGN_SENDER_ID=

# Appointment SMS scheduler
APPT_SCHEDULER_ENABLED=true
APPT_SCHEDULER_INTERVAL_MS=60000
APPT_TIMEZONE=UTC

# Live GPS for geo SMS (mobile app posts to POST /sms/live-location/ping)
# Same secret must be sent as header: X-Live-Location-Key: <value>
LIVE_LOCATION_INGEST_KEY=change-me-long-random-string
# Only pings newer than this are used for geo targeting (default 15)
# LIVE_LOCATION_MAX_AGE_MINUTES=15
