# Railway production environment template
# Paste these entries into the BACKEND service Variables tab. Replace every
# REPLACE_* value with a real credential. Never commit actual secrets.

# Server and public application URLs
NODE_ENV=production
HOST=0.0.0.0
CORS_ORIGIN=https://frontend-production-05f5.up.railway.app
FRONTEND_URL=https://frontend-production-05f5.up.railway.app
TRUST_PROXY=loopback
REQUEST_BODY_LIMIT=1mb

# Railway MySQL service references. These assume the database service is named
# MySQL; change the prefix if your Railway database has a different name.
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_DIALECT=mysql
DB_RUN_STARTUP_MAINTENANCE=false
DB_CONNECT_TIMEOUT_MS=15000
DB_POOL_MAX=10
DB_POOL_ACQUIRE_MS=60000

# Generate each JWT value separately with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_REFRESH_SECRET

# Generate these independently with the same command. SMS_WEBHOOK_SECRET is
# also appended to provider callback URLs using ?secret=<value>.
SMS_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
LIVE_LOCATION_INGEST_KEY=REPLACE_WITH_RANDOM_LOCATION_KEY

# Email used by password reset. For Gmail, SMTP_PASS must be an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_EMAIL
SMTP_PASS=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM=Afroel SMS <REPLACE_WITH_SMTP_EMAIL>

# Deploy with Africa's Talking first. Keep selection false until MobileSMS.io
# is fully configured, then change it to true without rebuilding the app.
SMS_PROVIDER=africastalking
SMS_PROVIDER_USER_SELECTABLE=false
AT_USERNAME=REPLACE_WITH_AT_USERNAME
AT_API_KEY=REPLACE_WITH_AT_API_KEY
AT_SENDER_ID=
AT_COST_PER_SMS=0.05

# MobileSMS.io can be completed after the initial deployment.
MOBILESMS_IO_BASE_URL=
MOBILESMS_IO_SEND_PATH=/sms/send
MOBILESMS_IO_API_KEY=
MOBILESMS_IO_AUTH_STYLE=bearer
MOBILESMS_IO_REQUEST_FORMAT=json
MOBILESMS_IO_API_KEY_HEADER=X-API-Key
MOBILESMS_IO_QUERY_PARAM=api_key
MOBILESMS_IO_FIELD_TO=to
MOBILESMS_IO_FIELD_MESSAGE=message
MOBILESMS_IO_FIELD_FROM=from
MOBILESMS_IO_DEFAULT_SENDER=
MOBILESMS_IO_STRIP_PLUS=false
MOBILESMS_IO_MESSAGE_ID_JSON_PATH=message_id
MOBILESMS_IO_SUCCESS_FLAG_PATH=
MOBILESMS_IO_SUCCESS_FLAG_EXPECTED=true
MOBILESMS_IO_EXTRA_JSON=
MOBILESMS_IO_TIMEOUT_MS=30000
MOBILESMS_IO_COST_PER_SMS=0.07

# Provider-specific webhook secrets are optional because the universal secret
# above protects both callback endpoints.
AT_WEBHOOK_SECRET=
MOBILESMS_IO_WEBHOOK_SECRET=
MOBILESMS_IO_WEBHOOK_FROM_PATH=
MOBILESMS_IO_WEBHOOK_TO_PATH=
MOBILESMS_IO_WEBHOOK_TEXT_PATH=
MOBILESMS_IO_WEBHOOK_MESSAGE_ID_PATH=
MOBILESMS_IO_WEBHOOK_DATE_PATH=
MOBILESMS_IO_WEBHOOK_STATUS_PATH=
MOBILESMS_IO_WEBHOOK_PHONE_PATH=
MOBILESMS_IO_WEBHOOK_NETWORK_CODE_PATH=
MOBILESMS_IO_WEBHOOK_FAILURE_REASON_PATH=
MOBILESMS_IO_WEBHOOK_RETRY_COUNT_PATH=

# Phone and inbound routing
DEFAULT_PHONE_REGION=ET
DEFAULT_PHONE_COUNTRY_CODE=251
INBOUND_SMS_COMPANY_ID=

# Background processing
CAMPAIGN_SCHEDULER_ENABLED=true
CAMPAIGN_SCHEDULER_INTERVAL_MS=60000
CAMPAIGN_SENDER_ID=
APPT_SCHEDULER_ENABLED=true
APPT_SCHEDULER_INTERVAL_MS=60000
APPT_TIMEZONE=UTC
APPT_NOTIFICATION_CATCHUP_MINUTES=1440
LIVE_LOCATION_MAX_AGE_MINUTES=15

# Railway service settings (configure outside Variables):
# Pre-deploy command: npm run db:migrate
# Start command:      npm start
# Health-check path:  /health
# Inbound callback:   https://smsbackend-production-fc8c.up.railway.app/sms/inbound?secret=<SMS_WEBHOOK_SECRET>
# Delivery callback:  https://smsbackend-production-fc8c.up.railway.app/sms/delivery-report?secret=<SMS_WEBHOOK_SECRET>
